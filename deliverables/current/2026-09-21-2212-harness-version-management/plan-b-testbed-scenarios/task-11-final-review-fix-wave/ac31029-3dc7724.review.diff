+    repoRoot = mkdtempSync(join(tmpdir(), 'hh-repo-'));
+    homeDir = mkdtempSync(join(tmpdir(), 'hh-home-'));
+  });
+  afterEach(() => {
+    rmSync(repoRoot, { recursive: true, force: true });
+    rmSync(homeDir, { recursive: true, force: true });

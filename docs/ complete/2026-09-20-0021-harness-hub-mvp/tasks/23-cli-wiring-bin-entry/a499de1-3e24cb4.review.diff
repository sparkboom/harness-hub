+  it('fails clearly outside a git repo', async () => {
+    const nonRepo = mkdtempSync(join(tmpdir(), 'hh-nonrepo-'));
+    process.chdir(nonRepo);
+    expect(await main(['doctor'])).toBe(1);
+    rmSync(nonRepo, { recursive: true, force: true });
+  });
+});
